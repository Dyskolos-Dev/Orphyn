{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orphyn",
  "mainBinaryName": "Orphyn",
  "version": "../package.json",
  "identifier": "app.lumen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "publisher": "Dyskolos_",
    "copyright": "Copyright (c) Dyskolos_",
    "category": "Entertainment",
    "shortDescription": "A desktop Jellyfin client for music, movies and series",
    "longDescription": "Orphyn - a desktop Jellyfin client for music, movies and series",
    "homepage": "https://github.com/Dyskolos-Dev/Orphyn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQTNBOEM1QzUwMUQ1RkQKUldUOTFRSEZ4YWlqLy9taHA1YUZrT2hPaFFBK0U1Z25sSnZYUlZRSVRtSFByV0JhSFU3MG15NkMK",
      "endpoints": ["https://github.com/Dyskolos-Dev/Orphyn/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
