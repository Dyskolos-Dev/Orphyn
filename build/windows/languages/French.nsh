; Strings the installer template reads (they were Tauri's language files, which are not shipped
; with the native build).
LangString addOrReinstall ${LANG_FRENCH} "Ajouter ou réinstaller des composants"
LangString alreadyInstalled ${LANG_FRENCH} "Déjà installé"
LangString alreadyInstalledLong ${LANG_FRENCH} "${PRODUCTNAME} ${VERSION} est déjà installé. Choisissez l’opération à effectuer puis cliquez sur Suivant."
LangString chooseMaintenanceOption ${LANG_FRENCH} "Choisissez l’option de maintenance à effectuer."
LangString chooseHowToInstall ${LANG_FRENCH} "Choisissez comment installer ${PRODUCTNAME}."
LangString dontUninstall ${LANG_FRENCH} "Ne pas désinstaller"
LangString dontUninstallDowngrade ${LANG_FRENCH} "Ne pas désinstaller (revenir à une version antérieure sans désinstaller est désactivé)"
LangString newerVersionInstalled ${LANG_FRENCH} "Une version plus récente de ${PRODUCTNAME} est déjà installée. Il n’est pas recommandé d’installer une version plus ancienne."
LangString older ${LANG_FRENCH} "plus ancienne"
LangString olderOrUnknownVersionInstalled ${LANG_FRENCH} "Une version $R4 de ${PRODUCTNAME} est installée. Il est recommandé de la désinstaller avant l’installation."
LangString silentDowngrades ${LANG_FRENCH} "Les retours à une version antérieure sont désactivés. Utilisez l’installateur graphique."
LangString unableToUninstall ${LANG_FRENCH} "Désinstallation impossible !"
LangString uninstallApp ${LANG_FRENCH} "Désinstaller ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_FRENCH} "Désinstaller avant d’installer"
LangString unknown ${LANG_FRENCH} "inconnue"
LangString appRunning ${LANG_FRENCH} "${PRODUCTNAME} est en cours d’exécution. Fermez-le puis réessayez."
LangString appRunningOkKill ${LANG_FRENCH} "${PRODUCTNAME} est en cours d’exécution.$\nCliquez sur OK pour le fermer."
LangString failedToKillApp ${LANG_FRENCH} "Impossible de fermer ${PRODUCTNAME}. Fermez-le puis réessayez."
