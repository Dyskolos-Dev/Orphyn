{
  "name": "orphyn",
  "version": "2.0.3",
  "productName": "Orphyn",
  "description": "Orphyn - a desktop Jellyfin client for music, movies and series",
  "private": true,
  "homepage": "https://github.com/Dyskolos-Dev/Orphyn",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dyskolos-Dev/Orphyn.git"
  },
  "author": "Dyskolos_",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "cd native && cargo run -p orphyn-native",
    "build": "cd native && cargo build --release -p orphyn-native",
    "dist": "node scripts/native-package.mjs",
    "predist": "npm run installer-art",
    "installer-art": "node build/scripts/generate-installer-art.mjs",
    "check": "cd native && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4"
  }
