{
  "name": "jellyra",
  "version": "0.1.0",
  "description": "Jellyra - a desktop Jellyfin client for music, movies and series",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Jellyra",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dist": "npm run build && electron-builder",
    "e2e": "npm run build && playwright test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@jellyfin/sdk": "^1.0.2",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.13.0",
    "hls.js": "^1.7.4",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.72.0",
    "node-ssdp": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/node-ssdp": "^4.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
